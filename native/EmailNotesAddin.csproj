<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Outlook-Notes native COM add-in (.NET Framework 4.8, WinForms).
    Built on NetOffice (pure NuGet, no Office install needed) so the add-in COM
    plumbing is provided by a proven library instead of hand-declared interfaces.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>EmailNotes</RootNamespace>
    <AssemblyName>EmailNotesAddin</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <LangVersion>7.3</LangVersion>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- net48 reference assemblies so the build needs no local framework. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Proven Office COM add-in framework (brings NetOffice.Core + Outlook API). -->
    <PackageReference Include="NetOfficeFw.Outlook" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
